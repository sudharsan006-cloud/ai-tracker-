# AI Life Tracker Backend Environment Variables (Phase 1)
# Copy this file to .env and fill in real values. NEVER commit .env!

# Neon PostgreSQL JDBC URL (NON-pooled host, starting with jdbc:postgresql://)
DB_URL=jdbc:postgresql://ep-example-pooler-replace.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here

# JWT Secret: random string, at least 32 characters (256 bits)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_hs256!

# Token TTLs
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# CORS Allowed Origins (comma separated list of web origins)
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8080,http://localhost:3000

# Server Port
PORT=8080
